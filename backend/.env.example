# ── Railway Environment Variables ──────────────────────
# Copy this file to .env for local development
# Set these in Railway dashboard → Variables tab

# JWT secret — change this to a long random string in production
JWT_SECRET=shopwave_secret_change_this_in_production

# Your Vercel frontend URL (no trailing slash)
# Example: https://shopwave.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Port — Railway sets this automatically, do not override
# PORT=5000
